{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "tests/**/*.ts",
        "prisma/**/*.ts",
        "prisma.config.ts",
        "prisma.test.config.ts",
        "vitest.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
