# Application Environment (development, test, production)
NODE_ENV=production

# Server Port (1024 - 65535)
PORT=4000

# PostgreSQL Connection String (Use strong password and SSL in production)
DATABASE_URL="postgresql://retailflow_user:replace_with_strong_password@localhost:5432/retailflow_prod?schema=public&sslmode=prefer"

# JWT Secret (Base64 string with at least 32 characters)
JWT_SECRET_BASE64="replace_with_at_least_32_characters_random_string"

# CORS Origin (The frontend URL allowed to talk to this API)
APP_ORIGIN="https://retailflow-pos.yourdomain.com"